{
  "name": "flowpilot",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "setup": "npm install && npm install --prefix client",
    "build": "npm install --prefix client && npm run build --prefix client",
    "start": "node server/index.js",
    "dev:server": "node --watch --env-file=.env server/index.js",
    "dev:client": "npm run dev --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  }
}
